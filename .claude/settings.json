{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr merge*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rebase-lock-merge-guard.sh",
            "timeout": 30,
            "statusMessage": "Checking for an auto-rebase lock"
          }
        ]
      }
    ]
  }
}
